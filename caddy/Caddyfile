{
	# HTTP sites are declared explicitly below so origin-secret checks run before
	# an API or public request can be redirected to HTTPS.
	auto_https disable_redirects

	log public_error {
		output file /var/log/caddy/restobite_public_error.json
		format json
		level ERROR
		include http.log.error.public_access
	}
}

http://{$API_ORIGIN_HOST} {
	@authorized header X-Origin-Secret {$API_ORIGIN_SECRET}
	handle @authorized {
		redir https://{host}{uri} permanent
	}
	respond "Forbidden" 403
}

https://{$API_ORIGIN_HOST} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	@authorized header X-Origin-Secret {$API_ORIGIN_SECRET}
	handle @authorized {
		reverse_proxy backend:4000 {
			header_up Host {host}
		}
	}
	respond "Forbidden" 403
}

http://{$PUBLIC_ORIGIN_HOST} {
	@authorized header X-Origin-Secret {$PUBLIC_ORIGIN_SECRET}
	handle @authorized {
		redir https://{host}{uri} permanent
	}
	respond "Forbidden" 403
}

https://{$PUBLIC_ORIGIN_HOST} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	log public_access {
		output file /var/log/caddy/restobite_public_access.json
		format json
	}
	@authorized header X-Origin-Secret {$PUBLIC_ORIGIN_SECRET}
	handle @authorized {
		# Only the public menu document (including Next.js RSC responses), not
		# nested routes such as /invalidate. CloudFront's matching max_ttl is
		# configured in restobite-cloud/public-page/main.tf.
		@menu {
			method GET HEAD
			path_regexp menu ^/-/[^/]+/?$
		}
		header @menu {
			# Normalize Next.js's static-page header while preserving private,
			# no-store, no-cache and other nonstandard cache directives.
			>Cache-Control "(?i)^s-maxage=[0-9]+(,[[:space:]]*stale-while-revalidate(=[0-9]+)?)?$" "public, max-age=0, s-maxage=30, stale-if-error=86400"
			match {
				status 200 304
				header !Set-Cookie
			}
		}
		# A response that sets a cookie must not inherit the larger cache budget.
		header @menu Cache-Control "private, no-store" {
			match {
				status 200 304
				header Set-Cookie *
			}
		}
		reverse_proxy public:3000 {
			header_up Host {host}
		}
	}
	respond "Forbidden" 403
}

http://{$LOGS_HOST} {
	redir https://{host}{uri} permanent
}

https://{$LOGS_HOST} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy grafana:3000 {
		header_up Host {host}
	}
}
