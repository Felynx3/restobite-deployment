NODE_ENV=production
ASSETS_URL=https://assets.restobite.com
ASSETS_S3_BUCKET=replace-with-production-bucket
AWS_REGION=replace-with-aws-region
AWS_ACCESS_KEY_ID=replace-with-runtime-access-key
AWS_SECRET_ACCESS_KEY=replace-with-runtime-secret-key
DATABASE_URL=replace-with-cloud-sql-connection-url
JWT_SECRET=replace-with-jwt-secret
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_service_account
TENANT_INVALIDATION_URL_TEMPLATE=replace-with-invalidation-url-template
RECAPTCHA_KEY=replace-with-recaptcha-key
RECAPTCHA_PROJECT_ID=replace-with-recaptcha-project-id
LOG_CONSOLE_ENABLED=true
